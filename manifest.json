{
  "schemaVersion": 1,
  "id": "com.community.epub-export",
  "name": "ייצוא EPUB",
  "version": "1.3.0",
  "sdkVersion": "1.x",
  "description": "ייצוא ספרים מאוצריא ל-EPUB, Kobo, Word ו-FB2 מימין לשמאל: טווח, כמה ספרים בקובץ, מפרשים כהערות, גופנים, דף שער ופרטי זכויות.",
  "author": "zevisvei",
  "homepage": "https://github.com/zevisvei/otzaria-epub-export",
  "stability": "beta",
  "minAppVersion": "0.9.98",
  "entrypoint": "index.html",
  "icon": "assets/icon.png",
  "network": {
    "enabled": false,
    "allowlist": []
  },
  "permissions": [
    "library.books.read",
    "library.content.read",
    "library.links.read",
    "fs.user_files.write",
    "settings.read",
    "notes.read",
    "bookmarks.read",
    "fonts.local.read"
  ],
  "contributes": {
    "toolTab": {
      "title": "ייצוא EPUB",
      "order": 300,
      "allowOrderBeforeBuiltIns": false,
      "defaultPinned": true,
      "iconName": "book_download_24_regular"
    }
  }
}
